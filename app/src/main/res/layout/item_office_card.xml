<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/GovCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: Office Name & Service -->
        <TextView
            android:id="@+id/tvOfficeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/gov_text_primary"
            android:textSize="17sp"
            tools:text="Regional Passport Office" />

        <TextView
            android:id="@+id/tvOfficeService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/gov_secondary"
            android:textSize="14sp"
            tools:text="Passport Services" />

        <!-- Location row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Location"
                android:src="@drawable/ic_location" />

            <TextView
                android:id="@+id/tvOfficeLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/gov_text_secondary"
                android:textSize="13sp"
                tools:text="Ahmedabad, Gujarat" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/gov_divider" />

        <!-- Bottom row: Crowd status badge & View Details Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Crowd Badge -->
            <LinearLayout
                android:id="@+id/badgeCrowdStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_low"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/ivCrowdDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="Status"
                    android:src="@drawable/ic_crowd_low" />

                <TextView
                    android:id="@+id/tvCrowdStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/crowd_low"
                    android:textSize="13sp"
                    tools:text="Low Crowd • 15 min wait" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- View Details Action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewDetails"
                style="@style/GovOutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:paddingStart="12dp"
                android:paddingTop="0dp"
                android:paddingEnd="12dp"
                android:paddingBottom="0dp"
                android:text="@string/btn_view_details"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
