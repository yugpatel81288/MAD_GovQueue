<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gov_background">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gov_surface"
        app:elevation="1dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/gov_text_primary"
            app:title="Office Details"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:titleTextColor="@color/gov_text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Office Name & Service Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/GovCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvDetailOfficeName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/gov_text_primary"
                        android:textSize="22sp"
                        tools:text="Regional Passport Office" />

                    <TextView
                        android:id="@+id/tvDetailOfficeService"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/gov_secondary"
                        android:textSize="15sp"
                        tools:text="Passport Services" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Office Information Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/section_office_info"
                android:textColor="@color/gov_text_primary"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/GovCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Address -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/label_address"
                        android:textColor="@color/gov_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDetailAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/gov_text_primary"
                        android:textSize="15sp"
                        tools:text="Passport Seva Kendra, Mithakhali, Ahmedabad, Gujarat" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/gov_divider" />

                    <!-- Opening Hours -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/label_opening_hours"
                        android:textColor="@color/gov_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDetailHours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/gov_text_primary"
                        android:textSize="15sp"
                        tools:text="9:30 AM – 5:30 PM" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Current Crowd Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/section_current_crowd"
                android:textColor="@color/gov_text_primary"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/GovCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Crowd Badge (Text + Icon + Color) -->
                    <LinearLayout
                        android:id="@+id/badgeDetailCrowd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_low"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp">

                        <ImageView
                            android:id="@+id/ivDetailCrowdDot"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Status Dot"
                            android:src="@drawable/ic_crowd_low" />

                        <TextView
                            android:id="@+id/tvDetailCrowdStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.04"
                            android:textColor="@color/crowd_low"
                            android:textSize="14sp"
                            tools:text="LOW CROWD" />
                    </LinearLayout>

                    <!-- Estimated Wait with large number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/label_estimated_wait"
                        android:textColor="@color/gov_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDetailWaitTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/gov_primary"
                        android:textSize="32sp"
                        tools:text="15 minutes" />

                    <!-- Timestamp -->
                    <TextView
                        android:id="@+id/tvDetailLastUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/gov_text_tertiary"
                        android:textSize="12sp"
                        tools:text="Updated 5 minutes ago" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Queue Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/section_queue"
                android:textColor="@color/gov_text_primary"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/GovCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="@string/label_people_waiting"
                            android:textColor="@color/gov_text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDetailPeopleWaiting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/gov_text_primary"
                            android:textSize="28sp"
                            tools:text="12" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Queue"
                        android:src="@drawable/ic_nav_offices"
                        app:tint="@color/gov_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="24dp"
                android:orientation="vertical">

                <!-- Get Directions -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGetDirections"
                    style="@style/GovOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_get_directions"
                    app:icon="@drawable/ic_directions"
                    app:iconGravity="textStart"
                    app:iconTint="@color/gov_primary" />

                <!-- Report Crowd -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReportCrowd"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_report_crowd"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/gov_surface"
                    app:backgroundTint="@color/gov_primary"
                    app:cornerRadius="10dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
